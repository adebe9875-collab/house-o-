<script>
function downloadFile() {
  const status = document.getElementById('dlStatus');
  status.style.display = 'block';
  status.textContent = '⏳ جارٍ تجهيز الملف...';

  fetch('alphoenixa_os_simulator.html')
    .then(r => {
      if (r.ok) return r.blob();
      throw new Error('not found');
    })
    .then(blob => {
      triggerDownload(blob, 'ALphoenixaOS-1.0.html');
    })
    .catch(() => {
      const fallback = `<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head><meta charset="UTF-8"><title>ALphoenixa OS</title>
<style>body{font-family:sans-serif;background:#0d1117;color:#e6edf3;display:flex;align-items:center;justify-content:center;height:100vh;margin:0;text-align:center;}
.box{background:#161b22;padding:40px;border-radius:16px;border:1px solid #30363d;max-width:500px;}h1{color:#d70a53;}</style>
</head>
<body><div class="box">
<h1>ALphoenixa OS 1.0</h1>
<p>هذا الملف هو المحاكي الوهمي الكامل لـ ALphoenixa OS.</p>
<p style="color:#8b949e;font-size:13px;margin-top:12px;">صنع بواسطة: آدم — 2026</p>
</div></body></html>`;
      const blob = new Blob([fallback], { type: 'text/html' });
      triggerDownload(blob, 'ALphoenixaOS-1.0.html');
    });
}

function triggerDownload(blob, filename) {
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = filename; a.click();
  URL.revokeObjectURL(url);
  const status = document.getElementById('dlStatus');
  status.textContent = '✅ تم تحميل ' + filename;
}
</script>


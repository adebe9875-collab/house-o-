<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ALphoenixa OS — تحميل النظام</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: 'Segoe UI', Tahoma, Arial, sans-serif; background: #0d1117; color: #e6edf3; min-height: 100vh; }

/* ===== HEADER ===== */
.header {
  background: #161b22;
  border-bottom: 1px solid #30363d;
  padding: 14px 40px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: sticky; top: 0; z-index: 100;
}
.logo { display: flex; align-items: center; gap: 10px; text-decoration: none; color: #e6edf3; font-size: 1.2rem; font-weight: 700; }
.logo svg { width: 32px; height: 32px; }
.logo span { color: #d70a53; }
.nav { display: flex; gap: 24px; }
.nav a { color: #8b949e; text-decoration: none; font-size: 14px; transition: color .15s; }
.nav a:hover { color: #e6edf3; }

/* ===== HERO ===== */
.hero {
  background: linear-gradient(160deg, #1a0a17 0%, #0d1117 60%);
  padding: 80px 40px 60px;
  text-align: center;
  border-bottom: 1px solid #21262d;
}
.hero h1 { font-size: 2.6rem; font-weight: 800; margin-bottom: 12px; }
.hero h1 span { color: #d70a53; }
.hero p { font-size: 1.1rem; color: #8b949e; max-width: 560px; margin: 0 auto 32px; line-height: 1.7; }
.version-badge {
  display: inline-block; background: #21262d; border: 1px solid #30363d;
  border-radius: 20px; padding: 4px 14px; font-size: 13px; color: #8b949e; margin-bottom: 28px;
}
.swirl-hero { margin: 0 auto 28px; display: block; }

/* ===== DOWNLOAD BOX ===== */
.download-section { max-width: 860px; margin: 0 auto; padding: 50px 24px; }
.release-box {
  background: #161b22; border: 1px solid #30363d; border-radius: 12px;
  overflow: hidden; margin-bottom: 28px;
}
.release-header {
  padding: 20px 24px; border-bottom: 1px solid #21262d;
  display: flex; align-items: center; justify-content: space-between;
}
.release-title { font-size: 1rem; font-weight: 600; }
.release-date { font-size: 13px; color: #8b949e; }
.release-body { padding: 0; }
.download-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 14px 24px; border-bottom: 1px solid #21262d;
  transition: background .12s;
}
.download-row:last-child { border-bottom: none; }
.download-row:hover { background: #1c2128; }
.file-info { display: flex; align-items: center; gap: 10px; }
.file-icon { font-size: 18px; }
.file-name { font-size: 14px; font-weight: 500; }
.file-size { font-size: 12px; color: #8b949e; margin-top: 2px; }
.dl-btn {
  background: #d70a53; color: #fff; border: none; padding: 8px 18px;
  border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer;
  display: flex; align-items: center; gap: 6px; transition: background .15s;
}
.dl-btn:hover { background: #b50844; }
#dlStatus { font-size: 13px; color: #8b949e; padding: 14px 24px; text-align: center; display: none; }

/* ===== FEATURES GRID ===== */
.features { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 40px; }
@media (max-width: 640px) { .features { grid-template-columns: 1fr; } .header { padding: 14px 20px; } }
.feature-card {
  background: #161b22; border: 1px solid #30363d; border-radius: 10px;
  padding: 20px; text-align: center;
}
.feature-card .icon { font-size: 28px; margin-bottom: 10px; }
.feature-card h4 { font-size: 14px; font-weight: 600; margin-bottom: 6px; }
.feature-card p { font-size: 12px; color: #8b949e; line-height: 1.5; }

/* ===== KEYS ===== */
.keys-section { background: #161b22; border: 1px solid #30363d; border-radius: 12px; padding: 24px; margin-bottom: 28px; }
.keys-section h3 { font-size: 15px; font-weight: 700; margin-bottom: 14px; }
.key-list { font-family: monospace; font-size: 13px; color: #22c55e; line-height: 2; direction: ltr; }

/* ===== NOTICE ===== */
.notice {
  background: #1a1203; border: 1px solid #3d2c00; border-radius: 10px;
  padding: 16px 20px; font-size: 13px; color: #d4a72c; line-height: 1.7;
}
.notice strong { color: #f59e0b; }
.notice-red {
  background: #1a0510; border: 1px solid #3d000f; border-radius: 10px;
  padding: 16px 20px; font-size: 13px; color: #ff7b9c; line-height: 1.7; margin-bottom: 16px;
}
.notice-red strong { color: #ef4444; }

/* ===== FOOTER ===== */
footer { border-top: 1px solid #21262d; padding: 24px 40px; text-align: center; font-size: 12px; color: #484f58; }
</style>
</head>
